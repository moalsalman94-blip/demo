# رابط قاعدة البيانات (من Supabase: Project Settings > Database > Connection string)
# DATABASE_URL = رابط الـ pooler (port 6543) مع ?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL = الرابط المباشر (port 5432) - للـ migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# مفتاح سري طويل وعشوائي لتوقيع جلسات الدخول (ولّده بـ: openssl rand -base64 48)
AUTH_SECRET=""

# حساب مالك البرنامج (لوحة /admin) - بينعمل أول مرة بأمر npm run db:seed
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
